[Unit]
Description=SWASTHYA AI Streamlit application
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
User=swasthya
Group=swasthya
WorkingDirectory=/opt/swasthya
Environment=HOME=/var/lib/swasthya
EnvironmentFile=-/etc/swasthya/swasthya.env
Environment=OLLAMA_HOST=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=llama3.2:3b
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/swasthya/venv/bin/streamlit run app.py --server.address=127.0.0.1 --server.port=8501 --server.headless=true --browser.gatherUsageStats=false
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
